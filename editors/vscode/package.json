{
  "name": "tree-lang",
  "displayName": "tree-lang",
  "description": "Syntax highlighting for the tree-lang programming language",
  "version": "0.1.0",
  "publisher": "tree-lang",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "tree-lang",
        "aliases": ["tree-lang", "tree"],
        "extensions": [".tree"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tree-lang",
        "scopeName": "source.tree-lang",
        "path": "./syntaxes/tree-lang.tmLanguage.json"
      }
    ]
  }
}
