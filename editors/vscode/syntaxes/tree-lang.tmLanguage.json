{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tree-lang",
  "scopeName": "source.tree-lang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.tree-lang", "match": "//.*$" },
        { "name": "comment.block.tree-lang", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tree-lang",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.tree-lang", "match": "\\\\(x[0-9a-fA-F]{2}|.)" }]
    },
    "attributes": {
      "name": "meta.attribute.tree-lang",
      "match": "#\\s*[a-z_]+(\\([^)]*\\))?"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(struct|enum)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.tree-lang" },
            "2": { "name": "entity.name.type.tree-lang" },
            "3": { "name": "keyword.declaration.tree-lang" }
          }
        },
        {
          "match": "\\b(fn)\\s*(\\([^)]*\\))?\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.tree-lang" },
            "3": { "name": "entity.name.function.tree-lang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tree-lang",
          "match": "\\b(if|else|for|range|match|break|continue|return|from|spawn|run|select|defer|panic|recover)\\b"
        },
        {
          "name": "keyword.other.tree-lang",
          "match": "\\b(fn|var|const|type|struct|enum|import|package|thread|unsafe|extern|some)\\b"
        },
        { "name": "keyword.operator.cast.tree-lang", "match": "\\bas[!%|?]?" },
        { "name": "constant.language.tree-lang", "match": "\\b(true|false|none|it)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.tree-lang",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|Pool|Handle|Link|Thread)\\b"
        },
        { "name": "entity.name.type.tree-lang", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.tree-lang",
      "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.checked.tree-lang", "match": "[-+*/%]\\?|\\?\\?" },
        { "name": "keyword.operator.wrap-sat.tree-lang", "match": "[-+*][%|]" },
        { "name": "keyword.operator.tree-lang", "match": ":=|=>|\\+\\+|--|&&|\\|\\||[-+*/%<>=!&|^~]=?|\\.\\." }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.tree-lang" } }
    }
  }
}
