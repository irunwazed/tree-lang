fn main() {
    var x f64 = 10.0
    y := 4.0
    print(x / y, " ", x % y, " ", -x, " ", x * y + 0.5)
    var z f32 = 0.1
    print(z, " ", z as f64 > 0.09, " ", 2 as f32)
    print(1.0 / 0.0, " ", -1.0 / 0.0, " ", 1e-7, " ", 123456789.0)
}
// expect: 2.5 2.0 -10.0 40.5
// expect: 0.10000000149011612 true 2.0
// expect: inf -inf 1e-07 123456789.0
