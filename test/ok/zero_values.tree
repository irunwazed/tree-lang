type Inner struct {
    a i32
    f f64
    ok bool
}

type Outer struct {
    in  Inner
    cnt u8
}

fn main() {
    var i i64
    var f f32
    var b bool
    var o Outer
    print(i, " ", f, " ", b)
    print(o)
    // nilai nol terlacak: o.cnt + 1 terbukti aman
    print(o.cnt + 1)
}
// expect: 0 0.0 false
// expect: Outer { in: Inner { a: 0, f: 0.0, ok: false }, cnt: 0 }
// expect: 1
