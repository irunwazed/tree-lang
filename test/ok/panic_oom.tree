// array melebihi reservasi (TL_RESERVE_MB=1) → panic yang bisa di-recover; array lama tetap utuh
fn fill(n i64) i64 {
    var xs [..]i64
    for i := range n { xs.push(i) }
    return len(xs)
}

fn try_fill(n i64) i64 {
    defer {
        if some m := recover() { print("recovered: ", m) }
    }
    return fill(n)
}

fn main() {
    print(try_fill(1000))
    print(try_fill(1000000))
    print(try_fill(2000))
}
// env: TL_RESERVE_MB=1
// expect: 1000
// expect: recovered: growable array exceeds its reserved address space (TL_RESERVE_MB)
// expect: 0
// expect: 2000
