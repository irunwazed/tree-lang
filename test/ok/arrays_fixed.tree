const N = 5

type Grid struct {
    cells [3][3]u8
    id    u32
}

fn main() {
    a := [N]i64{10, 20, 30, 40, 50}
    var z [4]i64
    print(a, " ", z, " len ", len(a))
    for i := range N {
        a[i] = a[i] / 10    // indeks terbukti 0..4
    }
    print(a)
    var total i64
    for _, x := range a { total = total +| x }   // nilai elemen tidak dilacak
    print("total ", total)
    var g Grid
    g.cells[1][2] = 7
    g.id = 9
    print(g)
    k := 2
    print(a[k], " ", a[N - 1])
    b := a            // array tetap disalin (nilai)
    b[0] = 99
    print(a[0], " ", b[0])
}
// expect: [10, 20, 30, 40, 50] [0, 0, 0, 0] len 5
// expect: [1, 2, 3, 4, 5]
// expect: total 15
// expect: Grid { cells: [[0, 0, 0], [0, 0, 7], [0, 0, 0]], id: 9 }
// expect: 3 5
// expect: 1 99
