// Semua indeks di sini terbukti aman saat compile; tidak ada cek runtime.
fn get(xs []i64, i i64) i64 {
    if i < 0 || i >= len(xs) {
        return -1
    }
    return xs[i]
}

fn first(xs []i64) i64 {
    if len(xs) == 0 { return 0 }
    return xs[0]
}

fn main() {
    var xs [..]i64
    for i := range 1..6 { xs.push(i) }
    print(get(xs, 2), " ", get(xs, 9), " ", get(xs, -1), " ", first(xs))
    var sum i64
    for i := range len(xs) {
        xs.push(0)          // array hanya tumbuh: fakta i < len(xs) tetap benar
        sum = sum +| xs[i]
    }
    print("sum ", sum, " len ", len(xs))
    j := 3
    if j < len(xs) { print("xs[3] = ", xs[j]) }
    if len(xs) > 9 { print("xs[9] = ", xs[9]) }
}
// expect: 3 -1 -1 1
// expect: sum 15 len 10
// expect: xs[3] = 4
// expect: xs[9] = 0
