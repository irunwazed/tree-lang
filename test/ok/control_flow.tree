fn classify(n i64) i64 {
    if n < 0 {
        return -1
    } else if n == 0 {
        return 0
    } else {
        return 1
    }
}

fn main() {
    print(classify(-5), " ", classify(0), " ", classify(9))
    var i i64
    for i < 5 {
        i++
        if i == 2 { continue }
        if i == 4 { break }
        print("while ", i)
    }
    var n i32
    for {
        n += 1
        if n >= 3 { break }
    }
    print("loop ", n)
    for k := range 3 { print("for ", k) }
    for k := range 10..13 { print("range ", k) }
    var count i64
    for a := range 4 {
        for b := range 4 {
            if b > a { break }
            count++
        }
    }
    print("pairs ", count)
    t := true || classify(1) == 1
    f := false && classify(1) == 1
    print(t, " ", f)
}
// expect: -1 0 1
// expect: while 1
// expect: while 3
// expect: loop 3
// expect: for 0
// expect: for 1
// expect: for 2
// expect: range 10
// expect: range 11
// expect: range 12
// expect: pairs 10
// expect: true false
