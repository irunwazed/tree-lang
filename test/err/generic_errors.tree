fn pick[T](a, b T) T { return a }
fn bad[T]() T { var x T
    return x }
fn plus[T](a, b T) T { return a + b }
type P struct { x i64 }
fn main() {
    _ = pick(1, true)
    _ = bad()
    _ = plus(P{1}, P{2})
}
